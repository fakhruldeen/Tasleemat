{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-04.03.04.schema.json",
  "title": "Completed MILESTONE LIST Data Contract",
  "description": "Additive structural schema validating completed MILESTONE LIST artifact data payloads (PMO-04.03.04).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-04.03.04"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_code": {
          "type": "string"
        },
        "date_prepared": {
          "type": "string",
          "format": "date"
        },
        "project_manager": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "baselined",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "project_name",
        "date_prepared",
        "project_manager",
        "prepared_by"
      ]
    },
    "mandatory_milestones": {
      "type": "object",
      "properties": {
        "contractual_and_regulatory_milestones": {
          "type": "string",
          "minLength": 1,
          "description": "Legally binding delivery milestones, compliance deadlines, and contractual gate events."
        },
        "target_dates_and_deliverables_mandatory": {
          "type": "string",
          "minLength": 1,
          "description": "Fixed target calendar dates and verified deliverables associated with mandatory milestones."
        }
      },
      "required": [
        "contractual_and_regulatory_milestones",
        "target_dates_and_deliverables_mandatory"
      ]
    },
    "optional_and_internal_milestones": {
      "type": "object",
      "properties": {
        "internal_project_gate_milestones": {
          "type": "string",
          "minLength": 1,
          "description": "Major internal transition points, architectural baseline completions, and integration checkpoints."
        },
        "target_dates_and_deliverables_internal": {
          "type": "string",
          "minLength": 1,
          "description": "Planned schedule dates and required internal outcomes for managerial review milestones."
        }
      },
      "required": [
        "internal_project_gate_milestones",
        "target_dates_and_deliverables_internal"
      ]
    },
    "milestone_verification_and_criteria": {
      "type": "object",
      "properties": {
        "verification_evidence_and_sign_off_lead": {
          "type": "string",
          "minLength": 1,
          "description": "Required audit evidence, formal artifacts, and designated approval authority for milestone achievement."
        },
        "milestone_critical_path_impact": {
          "type": "string",
          "minLength": 1,
          "description": "Assessment of whether the milestone resides on the critical path and associated delivery float."
        }
      },
      "required": [
        "verification_evidence_and_sign_off_lead",
        "milestone_critical_path_impact"
      ]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "mandatory_milestones",
    "optional_and_internal_milestones",
    "milestone_verification_and_criteria"
  ]
}