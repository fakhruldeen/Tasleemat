{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-05.07.schema.json",
  "title": "Completed LESSONS LEARNED REGISTER Data Contract",
  "description": "Additive structural schema validating completed LESSONS LEARNED REGISTER artifact data payloads (PMO-05.07).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-05.07"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_code": {
          "type": "string"
        },
        "date_prepared": {
          "type": "string",
          "format": "date"
        },
        "project_manager": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "baselined",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "project_name",
        "date_prepared",
        "project_manager",
        "prepared_by"
      ]
    },
    "lessons_learned_entries": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the lesson learned (e.g., LLR-01)."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Knowledge area or project phase (e.g., Technical, Procurement, Schedule)."
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "description": "The triggering event, root cause, or situation encountered."
        },
        "lesson": {
          "type": "string",
          "minLength": 1,
          "description": "Detailed description of what worked well or what should be done differently."
        },
        "responsible_party": {
          "type": "string",
          "minLength": 1,
          "description": "Person or role assigned to document or disseminate the lesson."
        },
        "identifier_submitter": {
          "type": "string",
          "minLength": 1,
          "description": "Name or team identifying the lesson."
        },
        "next_implementation_opportunity_date": {
          "type": "string",
          "minLength": 1,
          "description": "Future milestone, project, or date where this lesson will be applied."
        },
        "organizational_impact_y_n": {
          "type": "string",
          "minLength": 1,
          "description": "Whether this lesson impacts enterprise processes, standards, or assets."
        },
        "comments": {
          "type": "string",
          "minLength": 1,
          "description": "Additional reflections, training recommendations, or references."
        }
      },
      "required": [
        "id",
        "category",
        "trigger",
        "lesson",
        "responsible_party",
        "identifier_submitter",
        "next_implementation_opportunity_date",
        "organizational_impact_y_n",
        "comments"
      ]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "lessons_learned_entries"
  ]
}