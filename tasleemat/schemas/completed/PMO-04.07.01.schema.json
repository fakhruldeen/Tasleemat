{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-04.07.01.schema.json",
  "title": "Completed Communications Management Plan Data Contract",
  "description": "Additive structural schema validating completed Communications Management Plan artifact data payloads (PMO-04.07.01).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-04.07.01"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "project_code": { "type": "string" },
        "date_prepared": { "type": "string", "format": "date" },
        "project_manager": { "type": "string", "minLength": 1 },
        "prepared_by": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["draft", "baselined", "in_review", "approved"]
        }
      },
      "required": ["project_name", "date_prepared", "project_manager", "prepared_by"]
    },
    "stakeholder_communication_requirements": {
      "type": "object",
      "properties": {
        "stakeholder_groups_and_needs": { "type": "string", "minLength": 5 },
        "communication_purpose_and_language": { "type": "string", "minLength": 5 }
      },
      "required": ["stakeholder_groups_and_needs", "communication_purpose_and_language"]
    },
    "protocols_and_channels": {
      "type": "object",
      "properties": {
        "approved_channels_and_tools": { "type": "string", "minLength": 5 },
        "confidentiality_and_security_rules": { "type": "string", "minLength": 5 }
      },
      "required": ["approved_channels_and_tools", "confidentiality_and_security_rules"]
    },
    "communication_matrix_and_cadence": {
      "type": "object",
      "properties": {
        "items_and_target_audience": { "type": "string", "minLength": 5 },
        "frequency_format_and_sender": { "type": "string", "minLength": 5 }
      },
      "required": ["items_and_target_audience", "frequency_format_and_sender"]
    },
    "escalation_and_glossary": {
      "type": "object",
      "properties": {
        "urgent_escalation_process": { "type": "string", "minLength": 5 },
        "project_glossary_and_acronyms": { "type": "string", "minLength": 5 }
      },
      "required": ["urgent_escalation_process", "project_glossary_and_acronyms"]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "stakeholder_communication_requirements",
    "protocols_and_channels",
    "communication_matrix_and_cadence",
    "escalation_and_glossary"
  ]
}
