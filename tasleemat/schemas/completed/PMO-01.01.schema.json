{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-01.01.schema.json",
  "title": "Completed Business Case Data Contract",
  "description": "Additive structural schema validating completed Business Case artifact data payloads (PMO-01.01).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-01.01"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string" },
        "date_prepared": { "type": "string", "format": "date" },
        "business_sponsor": { "type": "string", "minLength": 1 },
        "lead_analyst": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["draft", "submitted", "approved", "rejected"]
        }
      },
      "required": ["project_name", "date_prepared", "business_sponsor", "lead_analyst"]
    },
    "business_need": {
      "type": "object",
      "properties": {
        "need_statement": { "type": "string", "minLength": 10 },
        "why_now": { "type": "string", "minLength": 5 },
        "who_feels_it": { "type": "string" },
        "cost_of_inaction": { "type": "string", "minLength": 5 }
      },
      "required": ["need_statement", "why_now", "cost_of_inaction"]
    },
    "situation_analysis": {
      "type": "object",
      "properties": {
        "current_state": { "type": "string", "minLength": 5 },
        "future_state_without_project": { "type": "string" },
        "root_causes": { "type": "string" },
        "constraints_and_assumptions": { "type": "string" }
      },
      "required": ["current_state"]
    },
    "options_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 5 },
          "benefits": { "type": "string" },
          "costs": { "type": "string" },
          "risks": { "type": "string" },
          "net_present_value": { "type": "string" }
        },
        "required": ["option_name", "description"]
      },
      "minItems": 1
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "recommended_option": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 10 }
      },
      "required": ["recommended_option", "rationale"]
    }
  },
  "required": ["artifact_id", "metadata", "business_need", "situation_analysis", "options_analysis", "recommendation"]
}
