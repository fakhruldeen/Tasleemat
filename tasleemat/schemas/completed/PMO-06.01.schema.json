{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-06.01.schema.json",
  "title": "Completed Project Status Report Data Contract",
  "description": "Additive structural schema validating completed Project Status Report artifact data payloads (PMO-06.01).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-06.01"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "project_code": { "type": "string" },
        "report_date": { "type": "string" },
        "reporting_period": { "type": "string" },
        "prepared_by": { "type": "string" },
        "overall_status": {
          "type": "string",
          "enum": ["Green", "Amber", "Red"]
        }
      },
      "required": ["project_name", "project_code", "report_date", "reporting_period", "prepared_by", "overall_status"]
    },
    "schedule_performance": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["Green", "Amber", "Red"] },
        "accomplishments_this_period": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "planned_but_not_completed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "schedule_variance_cause": { "type": "string" },
        "milestone_impact": { "type": "string" },
        "corrective_actions": { "type": "string" }
      },
      "required": ["status", "accomplishments_this_period"]
    },
    "cost_performance": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["Green", "Amber", "Red"] },
        "funds_spent_this_period": { "type": "number", "minimum": 0 },
        "variance_cause": { "type": "string" },
        "corrective_actions": { "type": "string" }
      },
      "required": ["status"]
    },
    "planning_next_period": {
      "type": "object",
      "properties": {
        "planned_accomplishments": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "planned_costs": { "type": "number", "minimum": 0 }
      },
      "required": ["planned_accomplishments"]
    },
    "risks_and_issues": {
      "type": "object",
      "properties": {
        "new_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "new_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "escalations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "required": ["artifact_id", "metadata", "schedule_performance", "cost_performance", "planning_next_period"]
}
