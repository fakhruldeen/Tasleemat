{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-05.05.schema.json",
  "title": "Completed QUALITY AUDIT REPORT Data Contract",
  "description": "Additive structural schema validating completed QUALITY AUDIT REPORT artifact data payloads (PMO-05.05).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-05.05"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_code": {
          "type": "string"
        },
        "date_prepared": {
          "type": "string",
          "format": "date"
        },
        "project_manager": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "baselined",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "project_name",
        "date_prepared",
        "project_manager",
        "prepared_by"
      ]
    },
    "area_audited": {
      "type": "object",
      "properties": {
        "area_audited": {
          "type": "string",
          "minLength": 1,
          "description": "Specific processes, documentation, deliverables, or quality procedures evaluated."
        }
      },
      "required": [
        "area_audited"
      ]
    },
    "good_practices_from_similar_projects": {
      "type": "object",
      "properties": {
        "good_practices_from_similar_projects": {
          "type": "string",
          "minLength": 1,
          "description": "High-performing practices, techniques, and benchmarks identified during audit."
        }
      },
      "required": [
        "good_practices_from_similar_projects"
      ]
    },
    "areas_for_improvement": {
      "type": "object",
      "properties": {
        "areas_for_improvement": {
          "type": "string",
          "minLength": 1,
          "description": "Gaps, performance deviations, and recommended procedural optimizations."
        }
      },
      "required": [
        "areas_for_improvement"
      ]
    },
    "deficiencies_or_defects": {
      "type": "object",
      "properties": {
        "deficiencies_or_defects": {
          "type": "string",
          "minLength": 1,
          "description": "Recorded defects, non-compliance items, and assigned corrective actions."
        }
      },
      "required": [
        "deficiencies_or_defects"
      ]
    },
    "implementation_tracking_of_approved_changes": {
      "type": "object",
      "properties": {
        "implementation_tracking_of_approved_changes": {
          "type": "string",
          "minLength": 1,
          "description": "Status of previously approved corrective actions, preventive actions, and defect repairs."
        }
      },
      "required": [
        "implementation_tracking_of_approved_changes"
      ]
    },
    "information_to_share_with_other_projects": {
      "type": "object",
      "properties": {
        "information_to_share_with_other_projects": {
          "type": "string",
          "minLength": 1,
          "description": "Valuable organizational insights, lessons, and quality benchmarks to disseminate."
        }
      },
      "required": [
        "information_to_share_with_other_projects"
      ]
    },
    "comments": {
      "type": "object",
      "properties": {
        "comments": {
          "type": "string",
          "minLength": 1,
          "description": "General observations, auditor notes, and executive summary."
        }
      },
      "required": [
        "comments"
      ]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "area_audited",
    "good_practices_from_similar_projects",
    "areas_for_improvement",
    "deficiencies_or_defects",
    "implementation_tracking_of_approved_changes",
    "information_to_share_with_other_projects",
    "comments"
  ]
}