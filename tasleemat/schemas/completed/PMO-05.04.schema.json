{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-05.04.schema.json",
  "title": "Completed CHANGE LOG Data Contract",
  "description": "Additive structural schema validating completed CHANGE LOG artifact data payloads (PMO-05.04).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-05.04"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_code": {
          "type": "string"
        },
        "date_prepared": {
          "type": "string",
          "format": "date"
        },
        "project_manager": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "baselined",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "project_name",
        "date_prepared",
        "project_manager",
        "prepared_by"
      ]
    },
    "change_log_entries": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the change request (e.g., CR-01)."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Change category (Scope, Schedule, Cost, Quality, Resource)."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Summary description of the proposed change."
        },
        "requestor": {
          "type": "string",
          "minLength": 1,
          "description": "Name or department submitting the change request."
        },
        "submission_date": {
          "type": "string",
          "minLength": 1,
          "description": "Date the change request was formally submitted."
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "description": "Current lifecycle state of the request (Submitted, Under Review, Approved, Rejected)."
        },
        "disposition": {
          "type": "string",
          "minLength": 1,
          "description": "Decision made by the Change Control Board (CCB)."
        },
        "cost_schedule_impact": {
          "type": "string",
          "minLength": 1,
          "description": "Estimated financial and timeline impact of the change."
        },
        "type_mandatory_discretionary": {
          "type": "string",
          "minLength": 1,
          "description": "Whether the change is legally mandatory or discretionary."
        },
        "configurable_items_impacted": {
          "type": "string",
          "minLength": 1,
          "description": "Configuration items, baselines, or specifications affected."
        }
      },
      "required": [
        "id",
        "category",
        "description",
        "requestor",
        "submission_date",
        "status",
        "disposition",
        "cost_schedule_impact",
        "type_mandatory_discretionary",
        "configurable_items_impacted"
      ]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "change_log_entries"
  ]
}