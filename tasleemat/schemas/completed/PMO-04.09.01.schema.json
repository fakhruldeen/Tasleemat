{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasleemat.pmo/schemas/completed/PMO-04.09.01.schema.json",
  "title": "Completed Procurement Management Plan Data Contract",
  "description": "Additive structural schema validating completed Procurement Management Plan artifact data payloads (PMO-04.09.01).",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "const": "PMO-04.09.01"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "project_code": { "type": "string" },
        "date_prepared": { "type": "string", "format": "date" },
        "project_manager": { "type": "string", "minLength": 1 },
        "prepared_by": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["draft", "baselined", "in_review", "approved"]
        }
      },
      "required": ["project_name", "date_prepared", "project_manager", "prepared_by"]
    },
    "integration_and_scheduling": {
      "type": "object",
      "properties": {
        "procurement_strategy": { "type": "string", "minLength": 5 },
        "timetable_alignment": { "type": "string", "minLength": 5 }
      },
      "required": ["procurement_strategy", "timetable_alignment"]
    },
    "roles_authority_and_metrics": {
      "type": "object",
      "properties": {
        "roles_and_authority": { "type": "string", "minLength": 5 },
        "vendor_metrics_slas": { "type": "string", "minLength": 5 }
      },
      "required": ["roles_and_authority", "vendor_metrics_slas"]
    },
    "contract_types_and_vendors": {
      "type": "object",
      "properties": {
        "contract_types_selection": { "type": "string", "minLength": 5 },
        "vendor_selection_approach": { "type": "string", "minLength": 5 }
      },
      "required": ["contract_types_selection", "vendor_selection_approach"]
    },
    "jurisdiction_and_risk": {
      "type": "object",
      "properties": {
        "jurisdiction_dispute_terms": { "type": "string", "minLength": 5 },
        "procurement_risk_mitigation": { "type": "string", "minLength": 5 }
      },
      "required": ["jurisdiction_dispute_terms", "procurement_risk_mitigation"]
    }
  },
  "required": [
    "artifact_id",
    "metadata",
    "integration_and_scheduling",
    "roles_authority_and_metrics",
    "contract_types_and_vendors",
    "jurisdiction_and_risk"
  ]
}
